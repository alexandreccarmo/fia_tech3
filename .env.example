# =============================================================================
# MedGraph - Assistente Clinico Auditavel
# Tech Challenge Fase 3 - 8IADT
#
# COMO USAR:
#   cp .env.example .env
#   e depois preencha os valores reais no arquivo .env (que nao vai para o git).
#
# Todas as variaveis abaixo sao lidas por config/settings.py.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) PROVEDOR DE LLM
# -----------------------------------------------------------------------------
# Define qual motor responde as perguntas clinicas. Valores aceitos:
#   ollama  -> nosso modelo FINE-TUNADO rodando local (padrao do projeto)
#   openai  -> gpt-4o-mini via API (usado como teto de referencia e fallback)
#   eco     -> modo offline sem LLM; responde com heuristicas. Serve para
#              rodar testes e demonstrar o grafo sem depender de nada externo.
LLM_PROVIDER=ollama

# --- Ollama (modelo fine-tunado servido localmente) --------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgraph

# --- OpenAI ------------------------------------------------------------------
# Crie a chave em platform.openai.com dentro de um PROJETO DEDICADO com
# limite de gasto definido. Permissao recomendada: Restricted > Model: Write.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Parametros de geracao ---------------------------------------------------
# Temperatura baixa e proposital: em contexto clinico queremos respostas
# reproduziveis e conservadoras, nao criativas.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# 2) CONTROLE DE CUSTO  [REQ-3b]
# -----------------------------------------------------------------------------
# Teto de gasto por sessao de execucao. Ao ultrapassar, o provider recusa
# novas chamadas pagas e levanta OrcamentoExcedidoError. Protege contra
# loops acidentais consumirem o credito da conta.
MAX_CUSTO_USD_SESSAO=1.00

# Cache em disco das respostas de LLM: rodar o mesmo script duas vezes
# nao cobra duas vezes.
HABILITAR_CACHE_LLM=true

# -----------------------------------------------------------------------------
# 3) EMBEDDINGS E RAG
# -----------------------------------------------------------------------------
# local  -> sentence-transformers rodando na maquina (gratis, offline)
# openai -> text-embedding-3-small (pago, porem barato)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_OPENAI=text-embedding-3-small

# Fatiamento dos documentos antes de indexar no FAISS.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# -----------------------------------------------------------------------------
# 4) COMPORTAMENTO DO GRAFO  [REQ-3a]
# -----------------------------------------------------------------------------
# Quantas vezes o no de reescrita pode tentar corrigir uma resposta que
# reprovou no guardrail de saida antes de degradar para resposta segura.
MAX_TENTATIVAS_GUARDRAIL=2

# Escore de risco (0.0 a 1.0) a partir do qual a resposta EXIGE validacao
# humana antes de ser entregue ao medico.
LIMIAR_RISCO_VALIDACAO_HUMANA=0.6

# -----------------------------------------------------------------------------
# 5) LOGGING E AUDITORIA  [REQ-3b]
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_CONSOLE_RICH=true
LOG_ARQUIVO=true
LOG_AUDITORIA_JSONL=true
LOG_SALVAR_TRACE_COMPLETO=true

# -----------------------------------------------------------------------------
# 6) FINE-TUNING E MODELO
# -----------------------------------------------------------------------------
# Modelo base usado no Colab. Alternativa sem gating: Qwen/Qwen2.5-3B-Instruct
MODELO_BASE_HF=meta-llama/Llama-3.2-3B-Instruct

# Repositorio no Hugging Face Hub de onde scripts/baixar_modelo.py puxa o GGUF.
REPO_GGUF_HF=alexandreccarmo/medgraph-llama32-3b-gguf
ARQUIVO_GGUF=medgraph-llama32-3b-q4_k_m.gguf

# Token do Hugging Face (necessario para baixar o Llama 3.2, que e gated).
HF_TOKEN=

# -----------------------------------------------------------------------------
# 7) AMOSTRAGEM DO DATASET
# -----------------------------------------------------------------------------
# Quantos exemplos do PubMedQA pqa_artificial entram no treino. Reduza para
# acelerar testes; 8000 e o valor usado na entrega final.
PUBMEDQA_ARTIFICIAL_AMOSTRA=8000
SEMENTE_ALEATORIA=42
